#pragma kernel EvaluateNoiseBatch

// Simple hash function
float hash(float3 p)
{
    p  = frac(p * 0.3183099 + 0.1);
    p *= 17.0;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

// Simple noise function
float noise(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    
    f = f * f * (3.0 - 2.0 * f);
    
    float n = 0.0;
    n += hash(i + float3(0,0,0)) * f.x * f.y * f.z;
    n += hash(i + float3(1,0,0)) * (1.0 - f.x) * f.y * f.z;
    n += hash(i + float3(0,1,0)) * f.x * (1.0 - f.y) * f.z;
    n += hash(i + float3(1,1,0)) * (1.0 - f.x) * (1.0 - f.y) * f.z;
    n += hash(i + float3(0,0,1)) * f.x * f.y * (1.0 - f.z);
    n += hash(i + float3(1,0,1)) * (1.0 - f.x) * f.y * (1.0 - f.z);
    n += hash(i + float3(0,1,1)) * f.x * (1.0 - f.y) * (1.0 - f.z);
    n += hash(i + float3(1,1,1)) * (1.0 - f.x) * (1.0 - f.y) * (1.0 - f.z);
    
    return n;
}

// Fractal Brownian Motion
float fbm(float3 p, int octaves, float persistence, float lacunarity)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    float maxValue = 0.0;
    
    for (int i = 0; i < octaves; i++)
    {
        value += noise(p * frequency) * amplitude;
        maxValue += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    
    return value / maxValue;
}

// Ridged noise
float ridged(float3 p, int octaves, float persistence, float lacunarity, float offset, float sharpness)
{
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    float maxValue = 0.0;
    
    for (int i = 0; i < octaves; i++)
    {
        float n = noise(p * frequency);
        n = offset - abs(n);
        n = pow(n, sharpness);
        value += n * amplitude;
        maxValue += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    
    return value / maxValue;
}

// Simple noise (single layer)
float simple(float3 p, float scale)
{
    return noise(p * scale);
}

// ============================================
// STRUCTS
// ============================================

struct NoiseConfig
{
    float3 pos;
    int noiseType;
    int octaves;
    float persistence;
    float lacunarity;
    float strength;
    float ridgeOffset;
    float ridgeSharpness;
    float scale;
    int enabled;
};

struct NoiseOutput
{
    float val;
};

// ============================================
// BUFFERS
// ============================================

RWStructuredBuffer<NoiseOutput> _Results;
StructuredBuffer<NoiseConfig> _Configs;
int _BatchCount;

// ============================================
// KERNEL
// ============================================

[numthreads(64, 1, 1)]
void EvaluateNoiseBatch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _BatchCount) return;
    
    NoiseConfig cfg = _Configs[id.x];
    
    if (cfg.enabled == 0)
    {
        _Results[id.x].val = 0.0;
        return;
    }
    
    float result = 0.0;
    
    if (cfg.noiseType == 0) // Simple
    {
        result = simple(cfg.pos, cfg.scale);
    }
    else if (cfg.noiseType == 1) // FBM
    {
        result = fbm(cfg.pos, cfg.octaves, cfg.persistence, cfg.lacunarity);
    }
    else if (cfg.noiseType == 2) // Ridged
    {
        result = ridged(cfg.pos, cfg.octaves, cfg.persistence, cfg.lacunarity, cfg.ridgeOffset, cfg.ridgeSharpness);
    }
    
    _Results[id.x].val = result * cfg.strength;
}